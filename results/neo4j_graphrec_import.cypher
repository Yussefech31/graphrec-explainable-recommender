// Neo4j Cypher Schema & Ingestion Script for GraphRec
CREATE CONSTRAINT IF NOT EXISTS FOR (u:User) REQUIRE u.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (m:Movie) REQUIRE m.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (g:Genre) REQUIRE g.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (d:Director) REQUIRE d.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (a:Actor) REQUIRE a.name IS UNIQUE;

MERGE (m:Movie {id: 1, title: 'Toy Story', year: 1995});
MERGE (:Genre {name: 'Animation'});
MATCH (m:Movie {id: 1}), (g:Genre {name: 'Animation'}) MERGE (m)-[:HAS_GENRE]->(g);
MERGE (:Genre {name: 'Children\'s'});
MATCH (m:Movie {id: 1}), (g:Genre {name: 'Children\'s'}) MERGE (m)-[:HAS_GENRE]->(g);
MERGE (:Genre {name: 'Comedy'});
MATCH (m:Movie {id: 1}), (g:Genre {name: 'Comedy'}) MERGE (m)-[:HAS_GENRE]->(g);
MERGE (:Director {name: 'John Lasseter'});
MATCH (m:Movie {id: 1}), (d:Director {name: 'John Lasseter'}) MERGE (m)-[:DIRECTED_BY]->(d);
MERGE (:Actor {name: 'Tom Hanks'});
MATCH (m:Movie {id: 1}), (a:Actor {name: 'Tom Hanks'}) MERGE (m)-[:STARRING]->(a);
MERGE (:Actor {name: 'Tim Allen'});
